PORT=4000
NODE_ENV=development

# JWT (openssl rand -base64 32 로 생성)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Supabase (SERVICE_ROLE_KEY — 서버 전용, 절대 프론트에 노출 금지)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Client
CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Demo account (포트폴리오 체험용 테스트 계정)
DEMO_ACCOUNT_EMAIL=demo@example.com
DEMO_ACCOUNT_PASSWORD=your_demo_password_here
